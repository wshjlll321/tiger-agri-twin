datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tree {
  id            String   @id @default(uuid())
  code          String   @unique // e.g., RUB-Z01-0023
  latitude      Float
  longitude     Float
  height        Float?
  crownWidth    Float?
  healthStatus  String   @default("HEALTHY") // HEALTHY, WARNING, CRITICAL
  plantedAt     DateTime?
  lastInspected DateTime @default(now())

  carbonCredits CarbonCredit[]
  diagnoses     DiseaseDiagnosis[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CarbonCredit {
  id        String   @id @default(uuid())
  amount    Float
  treeId    String
  tree      Tree     @relation(fields: [treeId], references: [id])

  calculatedAt DateTime @default(now())
}

model DroneFlightLog {
  id          String   @id @default(uuid())
  droneId     String
  startTime   DateTime
  endTime     DateTime?
  flightPath  Json?    // Storing path as JSON coordinates
  status      String   // COMPLETED, IN_PROGRESS, FAILED

  createdAt   DateTime @default(now())
}

model DiseaseDiagnosis {
  id          String   @id @default(uuid())
  treeId      String
  tree        Tree     @relation(fields: [treeId], references: [id])
  imageUrl    String
  diagnosis   String   // The AI output
  confidence  Float?

  createdAt   DateTime @default(now())
}
